# Supabase project settings — Project Settings > API nella dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — bypassa RLS, usata SOLO lato server (Server Actions,
# Route Handlers). Non prefissarla mai con NEXT_PUBLIC_, non esporla al client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — console.anthropic.com > API Keys. Usata solo lato server
# per generare il piano settimanale.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Opzionale, default claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Notifiche push (browser/PWA) — coppia di chiavi generata una tantum con
# `npx web-push generate-vapid-keys`, nessun account esterno necessario.
# La pubblica va esposta al client (prefisso NEXT_PUBLIC_), la privata mai.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Opzionale, contatto mostrato ai servizi push in caso di abuso
VAPID_SUBJECT=mailto:notifiche@groci.app

# Segreto condiviso con Vercel Cron per autenticare la chiamata giornaliera
# a /api/push/notifica-scadenze — stessa stringa qui e nelle env var del
# progetto Vercel (Vercel la allega da sola come header alle chiamate cron
# quando questa variabile è impostata). Qualunque stringa sufficientemente
# casuale va bene.
CRON_SECRET=your-random-secret
